# Виртуальное окружение и зависимости
.venv/
venv/
env/

# Кэш и сборки Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Настройки приложения: путь к записям, выбранный микрофон
settings.json

# Записи голоса и расшифровки
recordings/
*.wav
*.txt

# Кэш моделей Whisper (1,5 ГБ, качается один раз)
# Модель хранится в %USERPROFILE%\.cache\huggingface, этот путь — на случай переноса
.cache/
models--Systran--*

# Инструменты и редакторы
.idea/
.vscode/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Локальные заметки и временные файлы
*.log
*.db
*.db-shm
*.db-wal
temp/
notes/

# Служебное
.DS_Store
Thumbs.db